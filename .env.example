# BMW CarData device-flow credentials.
BMW_CLIENT_ID=replace-with-bmw-client-id
BMW_GCID=replace-with-bmw-gcid
BMW_REFRESH_TOKEN=replace-with-bmw-refresh-token
# Optional on first boot. Service obtains fresh ID token through refresh token.
BMW_ID_TOKEN=
BMW_VIN=replace-with-17-character-vin
BMW_SCOPE=authenticate_user openid cardata:api:read cardata:streaming:read
BMW_STREAM_HOST=customer.streaming-cardata.bmwgroup.com
BMW_STREAM_PORT=9000
BMW_MQTT_CLIENT_ID=bmw-cardata-imou
BMW_REFRESH_INTERVAL_SECONDS=2700
BMW_KEEPALIVE_SECONDS=120
# BMW stream policy: wait at least one minute between connection attempts.
BMW_RECONNECT_DELAY_SECONDS=90
BMW_TOKEN_FILE=/data/bmw-tokens.json

# Target location. BMW CarData provides coordinates, not formatted address.
# Set these to target location coordinates and choose radius covering target area.
TARGET_NAME=target location
TARGET_LATITUDE=replace-with-target-latitude
TARGET_LONGITUDE=replace-with-target-longitude
TARGET_RADIUS_METERS=100
LOCATION_PAIR_WINDOW_SECONDS=60

# Imou OpenAPI credentials and camera target.
IMOU_BASE_URL=https://openapi-fk.easy4ip.com:443/openapi
IMOU_APP_ID=replace-with-imou-app-id
IMOU_APP_SECRET=replace-with-imou-app-secret
IMOU_DEVICE_ID=replace-with-imou-device-id
IMOU_CHANNEL_ID=0
IMOU_TIMEOUT_SECONDS=30
IMOU_DRY_RUN=false

# Logging.
LOG_LEVEL=INFO
