FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-explorer.txt .
RUN pip install --no-cache-dir -r requirements-explorer.txt

COPY archive_explorer ./archive_explorer

RUN useradd --create-home --uid 10001 explorer \
    && mkdir -p /data \
    && chown -R explorer:explorer /app /data

USER explorer

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3).read()"

CMD ["python", "-m", "archive_explorer", "serve", "--workspace", "/data", "--host", "0.0.0.0", "--port", "8501"]
